# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Python packaging/build output
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519
.ssh/

# Logs and generated telemetry/benchmark output
*.log
*.log.*
*.jsonl
/benchmark-results/
/benchmarks/
/validation-results/
/batteryos-v03/
hardware-inventory*.json

# Generated OS images and filesystem artifacts
*.iso
*.img
*.hybrid.iso
*.squashfs

# Local backups and temporary/lock files
*.bak
*.tmp
*.swp
*.swo
*~

# IDE/editor state
.vscode/
.idea/
*.code-workspace

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini
